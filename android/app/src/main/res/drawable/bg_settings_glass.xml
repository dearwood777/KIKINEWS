<?xml version="1.0" encoding="utf-8"?>
<!--
  小浮层底：半透明深冷色 + 圆角 + 一根极细的高光描边。
  这层同时给 root 提供 outline —— root 的 clipToOutline=true 就是靠它裁圆角的。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="#B4151820" />
    <stroke android:width="0.7dp" android:color="#2BFFFFFF" />
</shape>
