<?xml version="1.0" encoding="utf-8"?>
<!--
  4×1 / 4×2 共用一套布局：
  w_multi  —— 能放下两行以上时用：顶行日期/页码/箭头 + 最多 6 条标题，
              每一行用 layout_weight 平分剩余高度，所以平板上多大都能填满，不会空在底下
  w_single —— 高度只够一行时用的紧凑行
  两者互斥显示，由 WidgetRenderer 按组件实际高度决定。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget">

    <LinearLayout
        android:id="@+id/w_multi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="6dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#8b93a7"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/w_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#6f7789"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/w_prev"
                android:layout_width="30dp"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#cfd6e4"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/w_next"
                android:layout_width="30dp"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#cfd6e4"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 六行等权：显示几行由代码控制，可见的行平分剩余高度 -->
        <LinearLayout
            android:id="@+id/w_r1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_t1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#e2e8f4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#4fd1c5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_r2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_t2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#e2e8f4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#4fd1c5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_r3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_t3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#e2e8f4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_s3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#4fd1c5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_r4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_t4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#e2e8f4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_s4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#4fd1c5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_r5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_t5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#e2e8f4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_s5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#4fd1c5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_r6"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_t6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#e2e8f4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_s6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#4fd1c5"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 单行模式（手机上的 4×1）：一条标题 + 时间 + 两个箭头 -->
    <LinearLayout
        android:id="@+id/w_single"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_stitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#e2e8f4"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_stime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#8b93a7"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/w_sprev"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#cfd6e4"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/w_snext"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="›"
            android:textColor="#cfd6e4"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
