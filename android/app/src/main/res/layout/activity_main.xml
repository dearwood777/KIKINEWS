<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E1320">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF0E1320">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textAlignment="center"
            android:textSize="15sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="重试" />
    </LinearLayout>

    <!-- 视觉缩小、热区不动：View 固定 62×26dp（改造前的实测尺寸，触摸范围与原版完全一致），
         缩的是里面的 bg_pill（<inset> 画到 40×16dp）和字号（13→11sp）。
         所以"按得到的地方"没变小，只是看起来变成了一个小胶囊 —— 网页那边 VSAFE=44 依旧安全。 -->
    <TextView
        android:id="@+id/settingsButton"
        android:layout_width="62dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="设置"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <!-- 下载进度条：浮在正文最底部，只占一条窄卡片的高度，
         正文照样能滑动阅读；出现时从下往上滑入，结束后自动收起。 -->
    <LinearLayout
        android:id="@+id/downloadBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_download_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="6dp"
        android:paddingBottom="11dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/dlIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_kv_update"
            android:tint="#4FD1C5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dlText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E9EFFB"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/dlProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#4FD1C5" />
        </LinearLayout>

        <TextView
            android:id="@+id/dlCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="取消"
            android:textColor="#9AA6BB"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
