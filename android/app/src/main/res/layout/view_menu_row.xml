<?xml version="1.0" encoding="utf-8"?>
<!-- 一行菜单：图标 + 标题 + 右侧当前值 + 底部分隔线（分隔线只到图标右边，苹果菜单的做法） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu_row"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingEnd="11dp">

        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:textColor="#EDEEF2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/row_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:textColor="#84878F"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:id="@+id/row_divider"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginStart="37dp"
        android:background="#17FFFFFF" />
</LinearLayout>
