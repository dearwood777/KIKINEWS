<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 的集合型布局（平板版：头部 24dp、字号更大）：头部固定一行，下面 ListView 填满剩余高度。
  ListView 的可见条数由系统实测高度决定，放不下就滚动，
  所以不会出现「只给三条、底下空一大片」，也不会出现「第三条只露半行」。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_a090">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_margin="5dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_corner_curl" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:contentDescription="@null"
        android:rotation="90"
        android:src="@drawable/ic_corner_curl" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="5dp"
        android:contentDescription="@null"
        android:rotation="270"
        android:src="@drawable/ic_corner_curl" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="5dp"
        android:contentDescription="@null"
        android:rotation="180"
        android:src="@drawable/ic_corner_curl" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#8b93a7"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/w_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#6f7789"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_set"
                android:layout_width="26dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#8b93a7"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_prev"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#cfd6e4"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/w_next"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#cfd6e4"
                android:textSize="17sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="true"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <TextView
            android:id="@android:id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textColor="#8b93a7"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
