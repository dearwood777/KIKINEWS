<?xml version="1.0" encoding="utf-8"?>
<!-- 设置行：图标 + 标题 + 副标题 + 右侧值。多行用 include 复用 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_row"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_row_icon"
        android:contentDescription="@null"
        android:padding="7dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E9EFFB"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/row_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#7F8AA0"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#8FE6DC"
        android:textSize="12sp" />
</LinearLayout>
