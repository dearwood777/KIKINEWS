<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HorizonBrief" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">#FF2563EB</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#FF0E1320</item>
        <!-- 窗口底色必须跟网页底色一致：WebView 是透明底，跨页瞬间露出来的就是这一层 -->
        <item name="android:windowBackground">#FF0E1320</item>
    </style>
    <!-- 设置面板：透明窗口 + 无系统转场，进出全靠自己那套「从胶囊放大 / 缩回」动画 -->
    <style name="Theme.HorizonBrief.Settings" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>