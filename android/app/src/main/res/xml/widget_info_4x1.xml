<?xml version="1.0" encoding="utf-8"?>
<!--
  4×1：targetCellWidth/Height 让 picker 在手机和平板上都标 4×1（Android 12+）；
  minWidth/minHeight 给 Android 11 及以下兜底。configure 打开透明度设置。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.kiki.horizonbrief.WidgetConfigActivity"
    android:description="@string/widget_desc_4x1"
    android:initialLayout="@layout/widget_card"
    android:maxResizeHeight="480dp"
    android:maxResizeWidth="560dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="250dp"
    android:minWidth="340dp"
    android:previewLayout="@layout/widget_card"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
